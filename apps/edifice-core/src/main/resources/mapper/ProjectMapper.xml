<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qsy.edifice.mapper.ProjectMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.qsy.edifice.domain.entity.Project">
        <id column="project_id" property="projectId" jdbcType="BIGINT"/>
        <result column="project_name" property="projectName" jdbcType="VARCHAR"/>
        <result column="project_code" property="projectCode" jdbcType="VARCHAR"/>
        <result column="project_type" property="projectType" jdbcType="BIGINT"/>
        <result column="project_status" property="projectStatus" jdbcType="TINYINT"/>
        <result column="is_show" property="isShow" jdbcType="TINYINT"/>
        <result column="project_start_time" property="projectStartTime" jdbcType="TIMESTAMP"/>
        <result column="project_end_time" property="projectEndTime" jdbcType="TIMESTAMP"/>
        <result column="created_time" property="createdTime" jdbcType="TIMESTAMP"/>
        <result column="updated_time" property="updatedTime" jdbcType="TIMESTAMP"/>
        <result column="is_delete" property="isDelete" jdbcType="TINYINT"/>
    </resultMap>

    <!-- 基础字段列表 -->
    <sql id="Base_Column_List">
        project_id, project_name, project_code, project_type, project_status, is_show,
        project_start_time, project_end_time, created_time, updated_time, is_delete
    </sql>

    <!-- 根据项目编码查询项目 -->
    <select id="selectByProjectCode" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM project
        WHERE project_code = #{projectCode}
        AND is_delete = 0
    </select>

    <!-- 根据项目状态查询项目列表 -->
    <select id="selectByProjectStatus" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM project
        WHERE project_status = #{projectStatus}
        AND is_delete = 0
    </select>

    <!-- 根据项目类型查询项目列表 -->
    <select id="selectByProjectType" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM project
        WHERE project_type = #{projectType}
        AND is_delete = 0
    </select>

    <!-- 根据用户id查询参与的项目id列表 -->
    <select id="selectProjectIdsByUserId" resultType="java.lang.Long">
        SELECT DISTINCT project_id
        FROM project_member
        WHERE user_id = #{userId}
        AND is_delete = 0
    </select>

    <!-- 获取项目统计信息 -->
    <select id="selectProjectStatistics" resultType="com.qsy.edifice.domain.vo.ProjectStatisticsVo">
        SELECT
            COUNT(*) as totalCount,
            SUM(CASE WHEN project_status = 1 THEN 1 ELSE 0 END) as processingCount,
            SUM(CASE WHEN project_status = 2 THEN 1 ELSE 0 END) as pendingAcceptanceCount,
            SUM(CASE WHEN project_status = 4 THEN 1 ELSE 0 END) as completedCount,
            0.0 as totalContractAmount
        FROM project
        WHERE is_delete = 0
    </select>
</mapper>
