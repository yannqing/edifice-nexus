<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qsy.edifice.mapper.SysRoleMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.qsy.edifice.domain.entity.SysRole">
        <id column="role_id" property="roleId" jdbcType="BIGINT"/>
        <result column="role_name" property="roleName" jdbcType="VARCHAR"/>
        <result column="role_code" property="roleCode" jdbcType="VARCHAR"/>
        <result column="role_desc" property="roleDesc" jdbcType="VARCHAR"/>
        <result column="status" property="status" jdbcType="TINYINT"/>
        <result column="created_time" property="createdTime" jdbcType="TIMESTAMP"/>
        <result column="updated_time" property="updatedTime" jdbcType="TIMESTAMP"/>
        <result column="is_delete" property="isDelete" jdbcType="TINYINT"/>
    </resultMap>

    <!-- 基础字段列表 -->
    <sql id="Base_Column_List">
        role_id, role_name, role_code, role_desc, status,
        created_time, updated_time, is_delete
    </sql>

    <!-- 根据用户ID查询角色列表 -->
    <select id="selectRolesByUserId" resultMap="BaseResultMap">
        SELECT
            sr.role_id, sr.role_name, sr.role_code, sr.role_desc,
            sr.status, sr.created_time, sr.updated_time, sr.is_delete
        FROM sys_role sr
                 INNER JOIN sys_user_role sur ON sr.role_id = sur.role_id
        WHERE sur.user_id = #{userId}
          AND sr.is_delete = 0
          AND sur.is_delete = 0
    </select>

</mapper>
