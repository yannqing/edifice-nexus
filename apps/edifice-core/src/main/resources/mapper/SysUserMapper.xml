<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qsy.edifice.mapper.SysUserMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.qsy.edifice.domain.entity.SysUser">
        <id column="user_id" property="userId" jdbcType="BIGINT"/>
        <result column="username" property="username" jdbcType="VARCHAR"/>
        <result column="password" property="password" jdbcType="VARCHAR"/>
        <result column="real_name" property="realName" jdbcType="VARCHAR"/>
        <result column="email" property="email" jdbcType="VARCHAR"/>
        <result column="phone" property="phone" jdbcType="VARCHAR"/>
        <result column="employee_no" property="employeeNo" jdbcType="VARCHAR"/>
        <result column="gender" property="gender" jdbcType="TINYINT"/>
        <result column="ethnicity" property="ethnicity" jdbcType="VARCHAR"/>
        <result column="birth_date" property="birthDate" jdbcType="DATE"/>
        <result column="id_card" property="idCard" jdbcType="VARCHAR"/>
        <result column="avatar" property="avatar" jdbcType="VARCHAR"/>
        <result column="education" property="education" jdbcType="VARCHAR"/>
        <result column="school" property="school" jdbcType="VARCHAR"/>
        <result column="major" property="major" jdbcType="VARCHAR"/>
        <result column="position" property="position" jdbcType="VARCHAR"/>
        <result column="oa_admin_id" property="oaAdminId" jdbcType="INTEGER"/>
        <result column="oa_userid" property="oaUserid" jdbcType="VARCHAR"/>
        <result column="department_id" property="departmentId" jdbcType="BIGINT"/>
        <result column="oa_department_id" property="oaDepartmentId" jdbcType="INTEGER"/>
        <result column="position_id" property="positionId" jdbcType="BIGINT"/>
        <result column="oa_position_id" property="oaPositionId" jdbcType="INTEGER"/>
        <result column="professional_title" property="professionalTitle" jdbcType="VARCHAR"/>
        <result column="certificates" property="certificates" jdbcType="VARCHAR"/>
        <result column="entry_date" property="entryDate" jdbcType="DATE"/>
        <result column="contract_end_date" property="contractEndDate" jdbcType="DATE"/>
        <result column="social_insurance_date" property="socialInsuranceDate" jdbcType="DATE"/>
        <result column="employment_status" property="employmentStatus" jdbcType="TINYINT"/>
        <result column="resign_date" property="resignDate" jdbcType="DATE"/>
        <result column="domicile" property="domicile" jdbcType="VARCHAR"/>
        <result column="address" property="address" jdbcType="VARCHAR"/>
        <result column="remark" property="remark" jdbcType="VARCHAR"/>
        <result column="sync_source" property="syncSource" jdbcType="VARCHAR"/>
        <result column="synced_at" property="syncedAt" jdbcType="TIMESTAMP"/>
        <result column="status" property="status" jdbcType="TINYINT"/>
        <result column="last_login_ip" property="lastLoginIp" jdbcType="VARCHAR"/>
        <result column="last_login_time" property="lastLoginTime" jdbcType="TIMESTAMP"/>
        <result column="created_time" property="createdTime" jdbcType="TIMESTAMP"/>
        <result column="updated_time" property="updatedTime" jdbcType="TIMESTAMP"/>
        <result column="is_delete" property="isDelete" jdbcType="TINYINT"/>
    </resultMap>

    <!-- 基础字段列表 -->
    <sql id="Base_Column_List">
        user_id, username, password, employee_no, real_name, gender, ethnicity, birth_date,
        id_card, email, phone, avatar, education, school, major, position, oa_admin_id,
        oa_userid, department_id, oa_department_id, position_id, oa_position_id,
        professional_title, certificates, entry_date, contract_end_date,
        social_insurance_date, employment_status, resign_date, domicile, address,
        remark, sync_source, synced_at, status, last_login_ip, last_login_time,
        created_time, updated_time, is_delete
    </sql>



    <!-- 根据用户名查询用户 -->
    <select id="selectByUsername" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM sys_user
        WHERE username = #{username}
        AND is_delete = 0
    </select>

    <!-- 根据手机号查询用户 -->
    <select id="selectByPhone" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM sys_user
        WHERE phone = #{phone}
        AND is_delete = 0
    </select>

    <!-- 根据邮箱查询用户 -->
    <select id="selectByEmail" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM sys_user
        WHERE email = #{email}
        AND is_delete = 0
    </select>

    <!-- 根据用户ID查询用户角色编码列表 -->
    <select id="selectRoleCodesByUserId" resultType="java.lang.String">
        SELECT DISTINCT sr.role_code
        FROM sys_role sr
                 INNER JOIN sys_user_role sur ON sr.role_id = sur.role_id
        WHERE sur.user_id = #{userId}
          AND sr.is_delete = 0
          AND sur.is_delete = 0
          AND sr.status = 1
    </select>

    <!-- 根据用户ID查询用户权限编码列表 -->
    <select id="selectPermissionCodesByUserId" resultType="java.lang.String">
        SELECT DISTINCT sp.permission_code
        FROM sys_permission sp
                 INNER JOIN sys_role_permission srp ON sp.permission_id = srp.permission_id
                 INNER JOIN sys_user_role sur ON srp.role_id = sur.role_id
                 INNER JOIN sys_role sr ON srp.role_id = sr.role_id
        WHERE sur.user_id = #{userId}
          AND sp.is_delete = 0
          AND srp.is_delete = 0
          AND sur.is_delete = 0
          AND sr.is_delete = 0
          AND sr.status = 1
    </select>
</mapper>
