<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qsy.edifice.mapper.ProjectFilesMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.qsy.edifice.domain.entity.ProjectFiles">
        <id column="project_file_id" property="projectFileId" jdbcType="BIGINT"/>
        <result column="project_id" property="projectId" jdbcType="VARCHAR"/>
        <result column="project_stage_id" property="projectStageId" jdbcType="BIGINT"/>
        <result column="file_id" property="fileId" jdbcType="BIGINT"/>
        <result column="created_time" property="createdTime" jdbcType="TIMESTAMP"/>
        <result column="updated_time" property="updatedTime" jdbcType="TIMESTAMP"/>
        <result column="is_delete" property="isDelete" jdbcType="TINYINT"/>
    </resultMap>

    <!-- 基础字段列表 -->
    <sql id="Base_Column_List">
        project_file_id, project_id, project_stage_id, file_id,
        created_time, updated_time, is_delete
    </sql>

    <!-- 根据项目id查询项目文件列表 -->
    <select id="selectByProjectId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM project_files
        WHERE project_id = #{projectId}
        AND is_delete = 0
    </select>

    <!-- 根据项目阶段id查询项目文件列表 -->
    <select id="selectByProjectStageId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM project_files
        WHERE project_stage_id = #{projectStageId}
        AND is_delete = 0
    </select>
</mapper>
