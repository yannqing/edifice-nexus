<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qsy.edifice.mapper.ProjectMemberMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.qsy.edifice.domain.entity.ProjectMember">
        <id column="project_member_id" property="projectMemberId" jdbcType="BIGINT"/>
        <result column="project_id" property="projectId" jdbcType="BIGINT"/>
        <result column="user_id" property="userId" jdbcType="BIGINT"/>
        <result column="project_role" property="projectRole" jdbcType="BIGINT"/>
        <result column="created_time" property="createdTime" jdbcType="TIMESTAMP"/>
        <result column="updated_time" property="updatedTime" jdbcType="TIMESTAMP"/>
        <result column="is_delete" property="isDelete" jdbcType="TINYINT"/>
    </resultMap>

    <!-- 基础字段列表 -->
    <sql id="Base_Column_List">
        project_member_id, project_id, user_id, project_role,
        created_time, updated_time, is_delete
    </sql>

    <!-- 根据项目id查询项目成员列表 -->
    <select id="selectByProjectId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM project_member
        WHERE project_id = #{projectId}
        AND is_delete = 0
    </select>

    <!-- 根据用户id查询项目成员列表 -->
    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM project_member
        WHERE user_id = #{userId}
        AND is_delete = 0
    </select>

    <!-- 根据项目id和用户id查询项目成员 -->
    <select id="selectByProjectIdAndUserId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM project_member
        WHERE project_id = #{projectId}
        AND user_id = #{userId}
        AND is_delete = 0
    </select>
</mapper>
