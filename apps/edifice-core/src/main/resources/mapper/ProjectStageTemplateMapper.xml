<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qsy.edifice.mapper.ProjectStageTemplateMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.qsy.edifice.domain.entity.ProjectStageTemplate">
        <id column="stage_id" property="stageId" jdbcType="BIGINT"/>
        <result column="stage_name" property="stageName" jdbcType="VARCHAR"/>
        <result column="project_type_id" property="projectTypeId" jdbcType="BIGINT"/>
        <result column="stage_output" property="stageOutput" jdbcType="DECIMAL"/>
        <result column="stage_status" property="stageStatus" jdbcType="TINYINT"/>
        <result column="created_time" property="createdTime" jdbcType="TIMESTAMP"/>
        <result column="updated_time" property="updatedTime" jdbcType="TIMESTAMP"/>
        <result column="is_delete" property="isDelete" jdbcType="TINYINT"/>
    </resultMap>

    <!-- 基础字段列表 -->
    <sql id="Base_Column_List">
        stage_id, stage_name, project_type_id, stage_output, stage_status,
        created_time, updated_time, is_delete
    </sql>

    <!-- 查询所有启用的阶段模版 -->
    <select id="selectAllEnabled" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM project_stage_template
        WHERE stage_status = 1
        AND is_delete = 0
    </select>

    <!-- 根据项目类型id查询启用的阶段模版 -->
    <select id="selectEnabledByProjectTypeId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM project_stage_template
        WHERE project_type_id = #{projectTypeId}
        AND stage_status = 1
        AND is_delete = 0
        ORDER BY stage_id ASC
    </select>
</mapper>
